&НаКлиенте
Процедура ОкончаниеРедактированияУникальногоИдентификатора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Значение = Неопределено;
	Если РезультатЗакрытия = Неопределено ИЛИ НЕ РезультатЗакрытия.Свойство("Значение", Значение) Тогда
		Возврат;
	КонецЕсли;

	СтрокаТаблицы = ТаблицаЗначений.НайтиПоИдентификатору(ДополнительныеПараметры.Строка);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаТаблицы[ДополнительныеПараметры.Поле] = Значение;

КонецПроцедуры
//Конец }

